title = NPT equilibration
integrator = md
nsteps               = 250000           ; 500 ps (250000 * 0.002 ps)
dt = 0.002
nstxout              = 0                ; suppress .trr coordinates
nstvout = 0              ; 不输出速度
nstenergy = 1000         ; 每 2 ps 输出能量
nstlog = 1000            ; 每 2 ps 输出日志
continuation = yes       ; 继续 NVT 模拟
constraint_algorithm = lincs
constraints = h-bonds
lincs_iter = 2
lincs_order = 4
cutoff-scheme = Verlet
ns_type = grid
nstlist = 10
rcoulomb = 1.0
rvdw = 1.0
coulombtype = PME
pme-order = 4
fourierspacing = 0.12
tcoupl = V-rescale
tc-grps = System
tau_t = 0.1
ref_t = 300
pcoupl               = Berendsen        ; faster/stable equilibration
pcoupltype = isotropic
nstpcouple = 10
tau_p                = 1.0              ; barostat time constant
ref_p = 1.0
compressibility = 4.5e-5
pbc = xyz
DispCorr = EnerPres
verlet-buffer-tolerance = 2.0e-05
gen-vel = no             ; 从 NVT 继承速度
nstxout-compressed = 5000 ; write xtc every 10 ps
compressed-x-grps = System ; xtc group
