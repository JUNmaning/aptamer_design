integrator            = md                ; MD 模拟
nsteps               = 100000           ; 200 ps (100000 * 0.002 ps)
dt                    = 0.002             ; 时间步长 2 fs
nstxout              = 0                ; suppress .trr coordinates (use xtc later)
nstvout               = 0                 ; 不输出速度
nstenergy             = 1000              ; 每 2 ps 输出能量
nstlog                = 1000              ; 每 2 ps 输出日志
continuation          = no                ; 全新模拟
constraint_algorithm  = lincs             ; LINCS 约束算法
constraints           = h-bonds           ; 约束含氢键，适合 AMBER
lincs_iter            = 1                 ; LINCS 迭代次数
lincs_order           = 4                 ; LINCS 精度
cutoff-scheme         = Verlet            ; Verlet 截断方案
nstlist               = 10                ; 邻居列表每 10 步更新
coulombtype           = PME               ; PME 静电
rcoulomb              = 1.0               ; 静电截断 1.0 nm
rvdw                  = 1.0               ; 范德华截断 1.0 nm
vdwtype               = Cut-off           ; 范德华截断类型
pme_order             = 4                 ; PME 插值阶数
fourierspacing        = 0.12              ; PME 网格间距
tcoupl                = V-rescale         ; V-rescale 温度耦合
tc-grps               = System            ; 单一温度组（移除分组耦合）
tau_t                 = 0.5               ; 温度耦合时间常数
ref_t                 = 300               ; 目标温度 300 K
pcoupl                = no                ; 无压力耦合（NVT）
gen_vel               = yes               ; 生成初始速度
gen_temp              = 300               ; 初始温度 300 K
DispCorr              = EnerPres          ; 分散校正
verlet-buffer-tolerance = 0.005           ; Verlet 缓冲容差，适合初始平衡
nstxout-compressed = 5000 ; write xtc every 10 ps
compressed-x-grps = System ; xtc group
